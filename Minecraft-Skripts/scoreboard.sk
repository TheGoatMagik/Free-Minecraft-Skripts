#======= Change the Scoreboards lines with whatever you want! =======
options:
	discord: discord.gg/xyz

function reloadScoreboard(p: player):
	if {kills.%{_p}%} is not set:
		set {kills.%{_p}%} to 0
	if {deaths.%{_p}%} is not set:
		set {deaths.%{_p}%} to 0
	if {playtimedays.%{_p}%} is not set:
		set {playtimedays.%{_p}%} to 0
	if {playtimehours.%{_p}%} is not set:
		set {playtimehours.%{_p}%} to 0
	if {playtimeminutes.%{_p}%} is not set:
		set {playtimeminutes.%{_p}%} to 0
	if {money.%{_p}%} is not set:
		set {money.%{_p}%} to 0
	set title of {_p}'s fastboard to "My Scoreboard"
	set line 1 of {_p}'s fastboard to ""
	set line 2 of {_p}'s fastboard to formatted "<#38FF12>⚔ Kills: <#FFDD00>%{kills.%{_p}%}%"
	set line 3 of {_p}'s fastboard to formatted "<#E60000>☠ Deaths: <#FFDD00>%{deaths.%{_p}%}%"
	set line 4 of {_p}'s fastboard to formatted "<#00C6E6>⏰ Playtime: <#FFDD00>%{playtimedays.%{_p}%}%d %{playtimehours.%{_p}%}%h %{playtimeminutes.%{_p}%}%m"
	set line 5 of {_p}'s fastboard to formatted "<#FFE700>💰 Money: <#FFDD00>%{money.%{_p}%}%"
	set line 6 of {_p}'s fastboard to formatted "<#5865F2>📢 Discord: {@discord}"
	set line 7 of {_p}'s fastboard to ""
#======= Load Scoreboard on join =======

on join:
	reloadScoreboard(player)

#======= Playtimecounter =======

every 1 minute:
	loop all players:
		add 1 to {playtimeminutes.%loop-player%}
		if {playtimeminutes.%loop-player%} = 60:
			set {playtimeminutes.%loop-player%} to 0
			add 1 to {playtimehours.%loop-player%}
			if {playtimehours.%loop-player%} = 24:
				set {playtimehours.%loop-player%} to 0
				add 1 to {playtimedays.%loop-player%}
		set {_p} to loop-player
		reloadScoreboard({_p})

#======= Kill and Death counter =======

on death:
	if victim is a player:
		add 1 to {deaths.%victim%}
		reloadScoreboard(victim)
		if attacker is a player:
			add 1 to {kills.%attacker%}
			reloadScoreboard(attacker)

#======= Money System =======

on first join:
	set {money.%player%} to 1000 #Change the Money to whatever a player should receive on his first join
	reloadScoreboard(player)

command /pay <player> <integer>:
	trigger:
		if arg-2 > {money.%player%}:
			send "<#FF0000>You don't have this amount of money!"
		else:
			add arg-2 to {money.%arg-1%}
			subtract arg-2 from {money.%player%}
			send "<#18FF00>You have succesfully paid <#FFE300>%arg-1% %arg-2% Money<#18FF00>!"
			send "<#18FF00>You received <#FFE300>%arg-2% Money <#18FF00>from <#FFE300>%player%!" to arg-1
		reloadScoreboard(player)
		reloadScoreboard(arg-1)

command /stats [<player>]:
	aliases: info
	permission: stats.use
	trigger:
		if arg-1 is set:
			send ""
			send "<#FFE700>Stats of <#18FF00>%arg-1%:"
			send ""
			send formatted "<#38FF12>⚔ Kills: <#FFE700>%{kills.%arg-1%}%"
			send formatted "<#E60000>☠ Deaths: <#FFE700>%{deaths.%arg-1%}%"
			send formatted "<#00C6E6>⏰ Playtime: <#FFE700>%{playtimedays.%arg-1%}%d %{playtimehours.%arg-1%}%h %{playtimeminutes.%arg-1%}%m"
			send formatted "<#FFE700>💰 Money: <#FFE700>%{money.%arg-1%}%"
			send ""
		else:
			send ""
			send formatted "<#FFE700>Your Stats:"
			send ""
			send formatted "<#38FF12>⚔ Kills: <#FFE700>%{kills.%player%}%"
			send formatted "<#E60000>☠ Deaths: <#FFE700>%{deaths.%player%}%"
			send formatted "<#00C6E6>⏰ Playtime: <#FFE700>%{playtimedays.%player%}%d %{playtimehours.%player%}%h %{playtimeminutes.%player%}%m"
			send formatted "<#FFE700>💰 Money: <#FFE700>%{money.%player%}%"
			send ""

