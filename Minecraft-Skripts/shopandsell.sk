#======= A script that adds a Shop and a Sell system. You can edit the Shop offers aswell as the Sellable Items at the bottom of the script (buy price, sellprice) =======
function shopAdd(category: text, item: itemtype, buy: number, sell: number):
	add 1 to {shop::%{_category}%::count}
	set {_n} to {shop::%{_category}%::count}
	set {shop::%{_category}%::item::%{_n}%} to {_item}
	set {shop::%{_category}%::buy::%{_n}%} to {_buy}
	set {shop::%{_category}%::sell::%{_n}%} to {_sell}
	sellAdd({_item}, {_sell})

function sellAdd(item: itemtype, sell: number):
	add {_item} to {shop::allitems::*}
	add {_sell} to {shop::allsell::*}

function shopSellPrice(item: item) :: number:
	loop {shop::allitems::*}:
		if {_item} is loop-value:
			return {shop::allsell::%loop-index%}
	return 0

function shopOpen(p: player):
	set {_inv} to new chest inventory with 3 rows named "<#FFE700>Shop"
	loop 27 times:
		set slot (loop-number - 1) of {_inv} to gray stained glass pane named ""
	set slot 10 of {_inv} to grass block named "<#FFE700>Blocks"
	set slot 11 of {_inv} to oak sapling named "<#FFE700>Nature"
	set slot 12 of {_inv} to diamond sword named "<#FFE700>PvP"
	set slot 13 of {_inv} to redstone named "<#FFE700>Redstone"
	set slot 14 of {_inv} to bread named "<#FFE700>Food"
	set slot 15 of {_inv} to netherrack named "<#FFE700>Nether"
	set slot 16 of {_inv} to end stone named "<#FFE700>End"
	open {_inv} to {_p}

function shopOpenCategory(p: player, category: text):
	set {shop::category::%{_p}%} to {_category}
	set {_inv} to new chest inventory with 4 rows named "<#FFE700>Shop - %{_category}%"
	loop {shop::%{_category}%::count} times:
		set {_n} to loop-number
		set {_item} to {shop::%{_category}%::item::%{_n}%}
		set {_buy} to {shop::%{_category}%::buy::%{_n}%}
		set {_sell} to {shop::%{_category}%::sell::%{_n}%}
		set lore of {_item} to "<#FFE700>Buy: %{_buy}% Money", "<#FFE700>Sell: %{_sell}% Money", "", "<#18FF00>Left-click: buy items" and "<#18FF00>Right-click: buy stacks"
		set slot ({_n} - 1) of {_inv} to {_item}
	loop 9 times:
		set slot (loop-number + 26) of {_inv} to gray stained glass pane named ""
	set slot 31 of {_inv} to arrow named "<#FFE700>Back"
	open {_inv} to {_p}

function shopOpenBuy(p: player):
	set {_category} to {shop::category::%{_p}%}
	set {_n} to {shop::number::%{_p}%}
	set {_amount} to {shop::amount::%{_p}%}
	set {_item} to {shop::%{_category}%::item::%{_n}%}
	set {_price} to {shop::%{_category}%::buy::%{_n}%}

	if {shop::stacks::%{_p}%} is true:
		set {_total} to {_amount} * (max stack size of {_item})
		set {_red} to red stained glass
		set {_green} to lime stained glass
		set {_unit} to "stacks"
		set {_maxtext} to "<#18FF00>Maximum (36 stacks)"
	else:
		set {_total} to {_amount}
		set {_red} to red stained glass pane
		set {_green} to lime stained glass pane
		set {_unit} to "items"
		set {_maxtext} to "<#18FF00>Full stack"
	set {_cost} to {_total} * {_price}
	set {shop::total::%{_p}%} to {_total}
	set {shop::cost::%{_p}%} to {_cost}

	set {_show} to {_amount} of {_item}
	set lore of {_show} to "<#FFE700>Amount: %{_amount}% %{_unit}%" and "<#FFE700>Price: %{_cost}% Money"

	set {_inv} to new chest inventory with 3 rows named "<#FFE700>Buy"
	loop 27 times:
		set slot (loop-number - 1) of {_inv} to gray stained glass pane named ""
	set slot 10 of {_inv} to {_red} named "<#FF0000>Reset to 1"
	set slot 11 of {_inv} to {_red} named "<#FF0000>-10"
	set slot 12 of {_inv} to {_red} named "<#FF0000>-1"
	set slot 13 of {_inv} to {_show}
	set slot 14 of {_inv} to {_green} named "<#18FF00>+1"
	set slot 15 of {_inv} to {_green} named "<#18FF00>+10"
	set slot 16 of {_inv} to {_green} named {_maxtext}
	set slot 22 of {_inv} to lime dye named "<#18FF00>Confirm Purchase" with lore "<#FFE700>Price: %{_cost}% Money"
	open {_inv} to {_p}

command /shop:
	trigger:
		shopOpen(player)

command /sell:
	trigger:
		set {_inv} to new chest inventory with 6 rows named "<#FFE700>Sell Items"
		loop 9 times:
			set slot (loop-number + 44) of {_inv} to gray stained glass pane named ""
		set slot 49 of {_inv} to lime dye named "<#18FF00>Sell" with lore "<#FFE700>Shift-click to sell all items"
		open {_inv} to player

on inventory click:
	if name of player's current inventory is "<#FFE700>Shop":
		cancel event
		set {_slot} to index of event-slot
		if name of event-inventory is not "<#FFE700>Shop":
			stop
		if {_slot} is 10:
			shopOpenCategory(player, "Blocks")
		else if {_slot} is 11:
			shopOpenCategory(player, "Nature")
		else if {_slot} is 12:
			shopOpenCategory(player, "PvP")
		else if {_slot} is 13:
			shopOpenCategory(player, "Redstone")
		else if {_slot} is 14:
			shopOpenCategory(player, "Food")
		else if {_slot} is 15:
			shopOpenCategory(player, "Nether")
		else if {_slot} is 16:
			shopOpenCategory(player, "End")

on inventory click:
	if name of player's current inventory contains "Shop - ":
		cancel event
		set {_slot} to index of event-slot
		if name of event-inventory doesn't contain "Shop - ":
			stop
		set {_category} to {shop::category::%player%}
		set {_n} to {_slot} + 1
		if {_slot} is 31:
			shopOpen(player)
		else if {shop::%{_category}%::item::%{_n}%} is set:
			set {shop::number::%player%} to {_n}
			set {shop::amount::%player%} to 1
			set {_click} to "%click type%"
			if {_click} contains "right":
				set {shop::stacks::%player%} to true
			else:
				set {shop::stacks::%player%} to false
			shopOpenBuy(player)

on inventory click:
	if name of player's current inventory is "<#FFE700>Buy":
		cancel event
		set {_slot} to index of event-slot
		if name of event-inventory is not "<#FFE700>Buy":
			stop
		set {_category} to {shop::category::%player%}
		set {_n} to {shop::number::%player%}
		set {_item} to {shop::%{_category}%::item::%{_n}%}
		set {_amount} to {shop::amount::%player%}

		if {_slot} is 22:
			set {_cost} to {shop::cost::%player%}
			set {_bought} to {shop::total::%player%} of {_item}
			if {money.%player%} is not set:
				set {money.%player%} to 0
			if {money.%player%} < {_cost}:
				send "<#FF0000>You don't have enough money!" to player
			else if player doesn't have enough space for {_bought}:
				send "<#FF0000>You don't have enough inventory space!" to player
			else:
				remove {_cost} from {money.%player%}
				give {_bought} to player
				send "<#18FF00>You bought %{_bought}% for %{_cost}% Money!" to player
				reloadScoreboard(player)
				shopOpenCategory(player, {_category})
			stop

		if {shop::stacks::%player%} is true:
			set {_max} to 36
		else:
			set {_max} to max stack size of {_item}

		if {_slot} is 10:
			set {_amount} to 1
		else if {_slot} is 11:
			remove 10 from {_amount}
		else if {_slot} is 12:
			remove 1 from {_amount}
		else if {_slot} is 14:
			add 1 to {_amount}
		else if {_slot} is 15:
			add 10 to {_amount}
		else if {_slot} is 16:
			set {_amount} to {_max}
		else:
			stop

		if {_amount} < 1:
			set {_amount} to 1
		if {_amount} > {_max}:
			set {_amount} to {_max}
		set {shop::amount::%player%} to {_amount}
		shopOpenBuy(player)

on inventory click:
	if name of player's current inventory is "<#FFE700>Sell Items":
		set {_slot} to index of event-slot
		if name of event-inventory is not "<#FFE700>Sell Items":
			stop
		if {_slot} < 45:
			stop
		cancel event
		set {_click} to "%click type%"
		if {_slot} is 49:
			if {_click} contains "shift":
				set {_total} to 0
				loop 45 times:
					set {_item} to slot (loop-number - 1) of event-inventory
					if {_item} is set:
						if {_item} is not air:
							set {_price} to shopSellPrice({_item})
							if {_price} > 0:
								add {_price} * (item amount of {_item}) to {_total}
								set slot (loop-number - 1) of event-inventory to air
				if {_total} > 0:
					add {_total} to {money.%player%}
					send "<#18FF00>You sold your items for %{_total}% Money!" to player
					reloadScoreboard(player)
				else:
					send "<#FF0000>None of these items can be sold!" to player
				close player's inventory

on inventory close:
	if name of event-inventory is "<#FFE700>Sell Items":
		loop 45 times:
			set {_item} to slot (loop-number - 1) of event-inventory
			if {_item} is set:
				if {_item} is not air:
					set slot (loop-number - 1) of event-inventory to air
					if player has enough space for {_item}:
						give {_item} to player
					else:
						drop {_item} at player

on inventory drag:
	set {_title} to name of player's current inventory
	if {_title} is "<#FFE700>Shop" or "<#FFE700>Buy":
		cancel event
	if {_title} contains "Shop - ":
		cancel event

